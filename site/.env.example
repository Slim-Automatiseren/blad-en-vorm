# Kopieer naar .env en vul in. Zonder deze waarden bouwt de site met de
# lokale seed-inhoud (src/inhoud/seed.json) in plaats van Sanity.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Op "ja" zetten bij livegang, tot die tijd krijgt elke pagina noindex
PUBLIC_INDEXEERBAAR=nee

# Het contactformulier loopt via Netlify Forms; daar is geen sleutel voor
# nodig, alleen formulierdetectie plus een e-mailnotificatie in de Netlify-UI.
