---
import { whatsappIcoon } from '../lib/iconen';
import type { Inhoud } from '../lib/inhoud';

interface Props {
  contact: Inhoud['contact'];
  instellingen: Inhoud['instellingen'];
  pakketOpties: string[];
}
const { contact, instellingen, pakketOpties } = Astro.props;
const f = contact.formulier;
---
<section id="contact" class="cream">
  <div class="wrap">
    <div class="contact-grid">
      <div class="reveal">
        <span class="label">{contact.label}</span>
        <h2 class="section-h kop-na-label">{contact.kop}</h2>
        <p class="lede">{contact.lede}</p>
        <div class="methods">
          <div class="method"><span class="label">{contact.labelEmail}</span><span class="val"><a href={`mailto:${instellingen.email}`}>{instellingen.email}</a></span></div>
          <div class="method"><span class="label">{contact.labelTelefoon}</span><span class="val"><a href={`tel:${instellingen.telefoonInternationaal}`}>{instellingen.telefoonWeergave}</a></span></div>
          <a href={`https://wa.me/${instellingen.whatsappNummer}?text=${encodeURIComponent(instellingen.whatsappBericht)}`} class="wa" rel="noopener">
            <Fragment set:html={whatsappIcoon} />
            WhatsApp
          </a>
        </div>
        <div class="werkgebied">
          <span class="label">{contact.labelWerkgebied}</span>
          <p>{contact.werkgebiedTekst}</p>
        </div>
      </div>
      <div class="reveal">
        <!-- Netlify Forms: gedetecteerd bij deploy via data-netlify; zonder JS
             verwerkt Netlify de POST en landt de bezoeker op /bedankt/ -->
        <form
          class="enq"
          id="contactForm"
          name="contact"
          method="post"
          action="/bedankt/"
          data-netlify="true"
          netlify-honeypot="website"
        >
          <input type="hidden" name="form-name" value="contact" />
          <div>
            <label for="f-naam">{f.veldNaam}</label>
            <input id="f-naam" name="naam" type="text" autocomplete="name" required />
          </div>
          <div>
            <label for="f-bedrijf">{f.veldBedrijf} <span class="los">{f.veldBedrijfToevoeging}</span></label>
            <input id="f-bedrijf" name="bedrijf" type="text" autocomplete="organization" />
          </div>
          <div>
            <label for="f-mail">{f.veldEmail}</label>
            <input id="f-mail" name="email" type="email" autocomplete="email" required />
          </div>
          <div>
            <label for="f-tel">{f.veldTelefoon} <span class="los">{f.veldTelefoonToevoeging}</span></label>
            <input id="f-tel" name="telefoon" type="tel" autocomplete="tel" />
          </div>
          <div>
            <label for="f-pakket">{f.veldPakket}</label>
            <select id="f-pakket" name="pakket">
              <option value="" disabled selected hidden>{f.keuzePlaceholder}</option>
              {pakketOpties.map((optie) => <option>{optie}</option>)}
              <option>{f.optieWeetNiet}</option>
            </select>
          </div>
          <div>
            <label for="f-ber">{f.veldBericht}</label>
            <textarea id="f-ber" name="bericht" rows="4" placeholder={f.berichtPlaceholder}></textarea>
          </div>
          <div class="veld-web" aria-hidden="true">
            <label for="f-web">Website</label>
            <input id="f-web" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <button class="btn" type="submit">{f.knop}</button>
          <p class="form-fout" id="formFout" role="alert">{f.foutmelding}</p>
          <p class="form-note">{f.privacy}</p>
        </form>
        <div class="succes" id="formSucces" role="status">
          <h3>{f.succesKop}</h3>
          <p>{f.succesTekst}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Pakket-CTA: vult het interesseveld zichtbaar voor, zodat "er gebeurde niets" niet kan
  const select = document.getElementById('f-pakket') as HTMLSelectElement;
  document.querySelectorAll('.pakket-cta').forEach((a) => {
    a.addEventListener('click', () => {
      select.value = a.getAttribute('data-pakket') ?? '';
      select.classList.add('flash');
      setTimeout(() => select.classList.remove('flash'), 1800);
    });
  });

  // Verzenden zonder paginawissel (Netlify Forms accepteert de POST op elk
  // pad); zonder JS post het formulier gewoon en landt de bezoeker op /bedankt/
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const succes = document.getElementById('formSucces') as HTMLElement;
  const fout = document.getElementById('formFout') as HTMLElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }
    fout.style.display = 'none';
    try {
      const velden = new URLSearchParams();
      new FormData(form).forEach((waarde, naam) => {
        if (typeof waarde === 'string') velden.append(naam, waarde);
      });
      const antwoord = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: velden.toString(),
      });
      if (!antwoord.ok) throw new Error(String(antwoord.status));
      form.style.display = 'none';
      succes.style.display = 'block';
      succes.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch {
      fout.style.display = 'block';
    }
  });
</script>
