---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import achtergrond from '../beelden/pakketten-achtergrond.jpg';
import fotoImpact from '../beelden/pakket-impact.jpg';
import fotoCorporate from '../beelden/pakket-corporate.jpg';
import fotoSignature from '../beelden/pakket-signature.jpg';
import fotoPrestige from '../beelden/pakket-prestige.jpg';
import { beeldBron } from '../lib/beeld';
import type { Inhoud } from '../lib/inhoud';

interface Props {
  pakketten: Inhoud['pakketten'];
}
const { pakketten } = Astro.props;
const eigenAchtergrond = beeldBron(pakketten.achtergrondFoto, [960, 1440]);

/* Standaardfoto per maat: de reeks toont per stap iets meer groen (vraag Marco).
   Een eigen foto uit Sanity gaat voor. */
const kaartFotos: Record<string, ImageMetadata> = {
  S: fotoImpact,
  M: fotoCorporate,
  L: fotoSignature,
  XL: fotoPrestige,
};

function prijsRegel(k: { prijsBedrag?: number; vanaf?: boolean }): string | null {
  if (!k.prijsBedrag) return null;
  const vanaf = k.vanaf ? `${pakketten.vanafWoord} ` : '';
  return `${vanaf}${k.prijsBedrag} ${pakketten.euroWoord}`;
}
---
<section id="pakketten" class="foto-band">
  {eigenAchtergrond ? (
    <img src={eigenAchtergrond.src} srcset={eigenAchtergrond.srcset} sizes="100vw" loading="lazy" alt="" aria-hidden="true" />
  ) : (
    <Image src={achtergrond} widths={[960, 1376]} sizes="100vw" alt="" aria-hidden="true" />
  )}
  <div class="scrim" aria-hidden="true"></div>
  <div class="wrap">
    <div class="kop-midden reveal">
      <span class="label">{pakketten.railLabel}</span>
      <h2 class="section-h">{pakketten.kop}</h2>
    </div>

    <div class="cards">
      {pakketten.kaarten.map((k) => {
        const eigenFoto = beeldBron(k.foto, [400, 640], 2 / 3);
        const standaard = kaartFotos[k.code] ?? fotoImpact;
        const prijs = prijsRegel(k);
        return (
          <div class="card">
            <figure class="kaart-foto" aria-hidden="true">
              {eigenFoto ? (
                <img src={eigenFoto.src} srcset={eigenFoto.srcset} sizes="(min-width: 900px) 23vw, (min-width: 560px) 45vw, 92vw" loading="lazy" alt="" />
              ) : (
                <Image src={standaard} widths={[400, 640]} sizes="(min-width: 900px) 23vw, (min-width: 560px) 45vw, 92vw" alt="" />
              )}
            </figure>
            <div class="kaart-inhoud">
              <h3>{k.naam}</h3>
              {prijs && <span class="prijs">{prijs} <small>{pakketten.perMaand}</small></span>}
              <p class="desc">{k.beschrijving}</p>
              {k.punten && k.punten.length > 0 && (
                <ul>
                  {k.punten.map((punt) => <li>{punt}</li>)}
                </ul>
              )}
              <div class="foot">
                <a href="#contact" class="btn ghost pakket-cta" data-pakket={k.naam}>{pakketten.ctaTekst}</a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
