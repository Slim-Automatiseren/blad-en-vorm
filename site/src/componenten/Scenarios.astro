---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import scenarioOntvangst from '../beelden/scenario-ontvangst.jpg';
import scenarioDirectie from '../beelden/scenario-directie.jpg';
import scenarioPraktijk from '../beelden/scenario-praktijk.jpg';
import { beeldBron } from '../lib/beeld';
import type { Inhoud } from '../lib/inhoud';

interface Props {
  scenarios: Inhoud['scenarios'];
}
const { scenarios } = Astro.props;

/* Eigen foto uit Sanity gaat voor (4:3-uitsnede met hotspot); zonder eigen
   foto geldt de standaardfoto van het gekozen slot. */
const slots: Record<string, { beeld: ImageMetadata; alt: string }> = {
  ontvangst: {
    beeld: scenarioOntvangst,
    alt: 'Eiken balie met daarnaast een volle groep planten: kentiapalm, monstera, ficus en varen in keramische potten',
  },
  directie: {
    beeld: scenarioDirectie,
    alt: 'Vergaderruimte met walnoten tafel en wollen stoelen, langs de wand een groep planten met monstera, kentiapalm en ficus',
  },
  praktijk: {
    beeld: scenarioPraktijk,
    alt: 'Wachtruimte met twee linnen fauteuils en een volle groep planten, kentiapalm, monstera en varens, in keramische potten',
  },
};
---
<section class="band">
  <div class="wrap">
    <div class="grid2">
      <div class="rail reveal">
        <span class="label">{scenarios.railLabel}</span>
        <p class="rail-note">{scenarios.railNote}</p>
      </div>
      <div class="reveal">
        <h2 class="section-h">{scenarios.kop}</h2>

        <div class="vw-rail" id="vwRail">
          {scenarios.items.map((s) => {
            const eigenFoto = beeldBron(s.foto, [320, 520, 760], 3 / 4);
            const slot = slots[s.beeldSlot];
            return (
              <article class="vw-card">
                {(eigenFoto || slot) && (
                  <figure class="plate">
                    <span class="tick tl"></span><span class="tick tr"></span><span class="tick bl"></span><span class="tick br"></span>
                    {eigenFoto ? (
                      <img
                        src={eigenFoto.src}
                        srcset={eigenFoto.srcset}
                        sizes="(min-width: 880px) 320px, 74vw"
                        loading="lazy"
                        alt={eigenFoto.alt ?? slot?.alt ?? ''}
                      />
                    ) : (
                      <Image src={slot.beeld} widths={[320, 520, 760]} sizes="(min-width: 880px) 320px, 74vw" alt={slot.alt} />
                    )}
                  </figure>
                )}
                <h3>{s.titel}</h3>
                <p>{s.tekst}</p>
                <a class="past" href="#pakketten"><span class="pip" aria-hidden="true"></span> {s.pastBij}</a>
              </article>
            );
          })}
        </div>
        <span class="vw-hint" id="vwHint">Sleep om te bekijken</span>
      </div>
    </div>
  </div>
</section>

<script>
  /* Voor wie: horizontale rij ruimtetypes. Slepen met de muis, en de hint
     verschijnt alleen als er echt iets te scrollen valt. Zonder JS blijft de
     rij met touch of trackpad scrollbaar, dus de inhoud is altijd bereikbaar. */
  const rail = document.getElementById('vwRail');
  const hint = document.getElementById('vwHint');
  if (rail) {
    const meetHint = () => {
      if (hint) hint.classList.toggle('zichtbaar', rail.scrollWidth - rail.clientWidth > 8);
    };
    meetHint();
    window.addEventListener('resize', meetHint);

    let neer = false;
    let startX = 0;
    let startL = 0;
    let bewogen = 0;
    rail.addEventListener('dragstart', (e) => e.preventDefault());
    rail.addEventListener('pointerdown', (e) => {
      neer = true;
      bewogen = 0;
      startX = e.clientX;
      startL = rail.scrollLeft;
      rail.classList.add('slepen');
      rail.setPointerCapture(e.pointerId);
    });
    rail.addEventListener('pointermove', (e) => {
      if (!neer) return;
      const d = e.clientX - startX;
      bewogen = Math.abs(d);
      rail.scrollLeft = startL - d;
    });
    const stop = () => {
      neer = false;
      rail.classList.remove('slepen');
    };
    rail.addEventListener('pointerup', stop);
    rail.addEventListener('pointercancel', stop);
    /* Een sleep mag geen klik op de "Past bij"-link worden */
    rail.addEventListener(
      'click',
      (e) => {
        if (bewogen > 6) {
          e.preventDefault();
          e.stopPropagation();
        }
      },
      true,
    );
  }
</script>
