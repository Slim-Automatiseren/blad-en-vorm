---
import logoHexagon from '../beelden/logo-hexagon.png';
import type { Inhoud } from '../lib/inhoud';

interface Props {
  instellingen: Inhoud['instellingen'];
}
const { instellingen } = Astro.props;
---
<footer class="site">
  <div class="wrap">
    <div class="top">
      <div>
        <a class="brand" href="#hoofd">
          <img class="mark" src={logoHexagon.src} width="29" height="34" alt="" aria-hidden="true" />
          <span class="name">Blad &amp; Vorm</span>
        </a>
        <p class="tagline">{instellingen.voetTagline}</p>
      </div>
      <div class="meta-f">
        <span>{instellingen.branche}</span>
        <span>{instellingen.werkgebied}</span>
        <span>{instellingen.email} · {instellingen.telefoonWeergave}</span>
      </div>
    </div>
    <div class="onder">
      <span>{instellingen.kvkRegel}</span>
      <span><a href="#">Algemene voorwaarden</a> · <a href="#">Privacyverklaring</a> · NL / EN</span>
    </div>
  </div>
</footer>
