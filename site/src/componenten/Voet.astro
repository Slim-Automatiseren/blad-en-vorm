---
import { linkedinIcoon, instagramIcoon } from '../lib/iconen';
import type { Inhoud } from '../lib/inhoud';

interface Props {
  instellingen: Inhoud['instellingen'];
  labelWerkgebied: string;
  taal: 'nl' | 'en';
}
const { instellingen, labelWerkgebied, taal } = Astro.props;

/* Werkgebied in drie rustige regels in plaats van één lange omslaande regel.
   De plaatsen blijven in het CMS één veld met puntjes ertussen. */
const plaatsen = instellingen.werkgebied.split('·').map((p) => p.trim()).filter(Boolean);
const perRij = Math.ceil(plaatsen.length / 3);
const rijen = [0, 1, 2]
  .map((r) => plaatsen.slice(r * perRij, (r + 1) * perRij))
  .filter((rij) => rij.length > 0)
  .map((rij) => rij.join(' · '));
---
<footer class="site">
  <div class="wrap">
    <div class="top">
      <div>
        <a class="brand" href="#hoofd">
          <span class="mark" aria-hidden="true"></span>
          <span class="name">Blad &amp; Vorm</span>
        </a>
        <p class="tagline">{instellingen.voetTagline}</p>
        <p class="omschrijving">{instellingen.branche}</p>
      </div>
      <div class="meta-f">
        <span class="label">{labelWerkgebied}</span>
        {rijen.map((rij) => <span>{rij}</span>)}
        <span class="contact-regel">{instellingen.email} · {instellingen.telefoonWeergave}</span>
      </div>
    </div>
    <div class="onder">
      <span>{instellingen.kvkRegel}</span>
      <span>
        <a href="#">{instellingen.privacyLabel}</a>
        {instellingen.linkedinUrl && (
          <>
            {' · '}
            <a href={instellingen.linkedinUrl} rel="noopener" class="sociaal" aria-label="LinkedIn">
              <Fragment set:html={linkedinIcoon} />
            </a>
          </>
        )}
        {instellingen.instagramUrl && (
          <>
            {' · '}
            <a href={instellingen.instagramUrl} rel="noopener" class="sociaal" aria-label="Instagram">
              <Fragment set:html={instagramIcoon} />
            </a>
          </>
        )}
        {' · '}
        {taal === 'nl' ? <span aria-current="page">NL</span> : <a href="/">NL</a>}
        {' / '}
        {taal === 'en' ? <span aria-current="page">EN</span> : <a href="/en/">EN</a>}
      </span>
    </div>
  </div>
</footer>

<style>
  /* Sociale iconen op de hoogte van de omliggende tekst in de onderregel */
  footer.site .onder a.sociaal {
    display: inline-flex;
    align-items: center;
    vertical-align: middle;
  }
  /* :global omdat de svg via set:html binnenkomt en Astro die niet scopet */
  footer.site .onder a.sociaal :global(svg) {
    width: 15px;
    height: 15px;
  }
</style>
