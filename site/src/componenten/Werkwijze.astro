---
import type { Inhoud } from '../lib/inhoud';

interface Props {
  werkwijze: Inhoud['werkwijze'];
}
const { werkwijze } = Astro.props;
---
<section id="werkwijze">
  <div class="wrap">
    <div class="grid2">
      <div class="rail reveal">
        <span class="label">{werkwijze.railLabel}</span>
        <p class="rail-note">{werkwijze.railNote}</p>
      </div>
      <div class="reveal">
        <h2 class="section-h">{werkwijze.kop}</h2>
        <div class="steps">
          {werkwijze.stappen.map((stap, i) => (
            <div class="step">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{stap.titel}</h3>
              <p>{stap.tekst}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
