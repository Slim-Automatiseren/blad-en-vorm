---
import Basis from '../layouts/Basis.astro';
import Nav from '../componenten/Nav.astro';
import Hero from '../componenten/Hero.astro';
import Inspiratie from '../componenten/Inspiratie.astro';
import Filosofie from '../componenten/Filosofie.astro';
import Diensten from '../componenten/Diensten.astro';
import InspiratieBoek from '../componenten/InspiratieBoek.astro';
import Pakketten from '../componenten/Pakketten.astro';
import Geschenken from '../componenten/Geschenken.astro';
import Over from '../componenten/Over.astro';
import Vragen from '../componenten/Vragen.astro';
import Contact from '../componenten/Contact.astro';
import Voet from '../componenten/Voet.astro';
import { haalInhoud } from '../lib/inhoud';
import { bedrijfsSchema, vragenSchema } from '../lib/schema';

const inhoud = await haalInhoud('nl');
const pakketOpties = inhoud.pakketten.kaarten.map((k) => k.naam);
---
<Basis
  titel="Blad & Vorm · Interieurbeplanting voor bedrijven en stijlvolle woonomgevingen"
  beschrijving="Blad & Vorm ontwerpt, levert en onderhoudt interieurbeplanting voor bedrijven en stijlvolle woonomgevingen, vanuit Wassenaar voor de regio Den Haag tot Noordwijk."
  vertaling={{ nl: '/', en: '/en/' }}
  schema={[bedrijfsSchema(inhoud.instellingen, 'nl', Astro.site!), vragenSchema(inhoud.vragen)]}
>
  <Nav nav={inhoud.nav} ctaLang={inhoud.hero.ctaPrimair} ctaKort={inhoud.hero.ctaPrimairKort} taal="nl" />

  <main id="hoofd">
    <Hero hero={inhoud.hero} />
    <Inspiratie inspiratie={inhoud.inspiratie} />
    <Filosofie filosofie={inhoud.filosofie} />
    <Diensten diensten={inhoud.diensten} />
    <InspiratieBoek inspiratieboek={inhoud.inspiratieboek} />
    <Pakketten pakketten={inhoud.pakketten} />
    <Geschenken geschenken={inhoud.geschenken} />
    <Over over={inhoud.over} />
    <Vragen vragen={inhoud.vragen} />
    <Contact contact={inhoud.contact} instellingen={inhoud.instellingen} pakketOpties={pakketOpties} />
  </main>

  <Voet instellingen={inhoud.instellingen} labelWerkgebied={inhoud.contact.labelWerkgebied} taal="nl" />
</Basis>
